extends Node2D

# Grilla del mapa: "#" es bloque solido, "." es aire.
# Se genera en runtime para mantener el nivel facil de editar como texto.
const GRASS := Vector2i(2, 1)
const DIRT := Vector2i(2, 2)
const FALL_LIMIT: float = 500.0

@onready var ground: TileMapLayer = $Ground
@onready var player: CharacterBody2D = get_tree().get_first_node_in_group("player")

var spawn_position: Vector2

var map: Array[String] = [
	"..................................................................................................................................",
	"..................................................................................................................................",
	"..............................................................................................................................####",
	"..............................................................................................................................####",
	"......................................######......................................................................................",
	"..................................................................................................................................",
	"..................................................................................................................................",
	"..................................................................................................................................",
	"......................................................................########....########..####..................................",
	"........................##########...###########......................########....########........................................",
	"........................##########...###########......................########....########........................................",
	"........................##########...###########......................########....########........................................",
	"###############..#################...#######################....##############....##################....##################........",
	"###############..#################...#######################....##############....##################....##################........",
	"###############..#################...#######################....##############....##################....##################........",
	"###############..#################...#######################....##############....##################....##################........",
]


func _ready() -> void:
	_build_map()
	if player:
		spawn_position = player.global_position


func _process(_delta: float) -> void:
	# Red de seguridad: si el jugador cae por un hueco, vuelve al punto de partida.
	if player and player.global_position.y > FALL_LIMIT:
		player.global_position = spawn_position
		player.velocity = Vector2.ZERO


func _build_map() -> void:
	for y in map.size():
		var row: String = map[y]
		for x in row.length():
			if row[x] != "#":
				continue
			var is_top: bool = y == 0 or map[y - 1][x] != "#"
			ground.set_cell(Vector2i(x, y), 0, GRASS if is_top else DIRT)
